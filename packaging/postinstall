#!/bin/sh
set -eu
agent='/Library/LaunchAgents/local.logitech.batterybridge.plist'
/bin/chmod 644 "$agent"
/usr/sbin/chown root:wheel "$agent"
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
if [ "$console_user" = 'root' ] || [ "$console_user" = 'loginwindow' ] || [ "$console_user" = '_mbsetupuser' ]; then
    echo 'Installed. The service will start at the next user login.'
    exit 0
fi
console_uid=$(/usr/bin/id -u "$console_user")
# Replace the earlier per-user prototype for this logged-in user without touching other files.
/bin/launchctl bootout "gui/$console_uid/local.logitech.batterybridge" 2>/dev/null || true
/bin/launchctl bootout "gui/$console_uid/local.m550.batterybridge" 2>/dev/null || true
/usr/bin/sudo -H -u "$console_user" /bin/sh -c '
    for name in local.logitech.batterybridge.plist local.m550.batterybridge.plist; do
        path="$HOME/Library/LaunchAgents/$name"
        if [ -f "$path" ] || [ -L "$path" ]; then
            /bin/mkdir -p "$HOME/Library/Application Support/LogitechBatteryBridge/PreviousLaunchAgents"
            /bin/mv -f "$path" "$HOME/Library/Application Support/LogitechBatteryBridge/PreviousLaunchAgents/$name"
        fi
    done
'
/bin/launchctl enable "gui/$console_uid/local.logitech.batterybridge" 2>/dev/null || true
if ! /bin/launchctl bootstrap "gui/$console_uid" "$agent"; then
    echo 'Files are installed. Log out and log back in to start the service.' >&2
fi
exit 0
