#!/bin/sh
set -eu
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" != "1" ]; then
    echo "This package requires an Apple silicon Mac (M series)." >&2
    exit 1
fi
system_version=$(/usr/bin/sw_vers -productVersion)
major_version=${system_version%%.*}
if [ "$major_version" -lt 14 ]; then
    echo "This package requires macOS 14.0 or later." >&2
    exit 1
fi
if [ "${3:-/}" != "/" ]; then
    echo "Install this package on the currently running system volume." >&2
    exit 1
fi
exit 0
